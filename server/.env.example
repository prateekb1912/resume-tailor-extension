# Copy to .env and fill in. Never commit the real .env.
ENVIRONMENT=development

# Postgres (wired up in Phase 1a)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_tailor

# Auth (wired up in Phase 1b) — generate with: openssl rand -hex 32
JWT_SECRET=

# LLM providers — Claude primary, GPT fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTML -> PDF service
GOTENBERG_URL=http://localhost:3000
