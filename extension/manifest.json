{
  "manifest_version": 3,
  "name": "Tailr",
  "version": "1.0.0",
  "description": "Read the job description on a page and tailor your resume to it.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}